<div class='receipt-ticket'>
  <div class='receipt-header'>
    <div class='store-info'>
      <h2>🔧
        {{#if storeSettings.storeName}}{{storeSettings.storeName}}{{else}}Smart
          TechRepair Hub{{/if}}</h2>
      <p>Hệ thống Quản lý Sửa chữa & Bảo hành Thiết bị Điện tử</p>
      <p><small>Hotline:
          {{#if
            storeSettings.storePhone
          }}{{storeSettings.storePhone}}{{else}}1900-1234{{/if}}
          | Địa chỉ:
          {{#if
            storeSettings.storeAddress
          }}{{storeSettings.storeAddress}}{{else}}123 Nguyễn Văn Cừ, Q.5, TP.HCM{{/if}}</small></p>
      {{#if storeSettings.taxCode}}<p><small>MST:
            {{storeSettings.taxCode}}</small></p>{{/if}}
    </div>
    <div class='ticket-title'>
      <h1>PHIẾU TIẾP NHẬN BẢO HÀNH & SỬA CHỮA</h1>
      <p class='tracking-big'>MÃ ĐƠN: <code>{{order.TrackingCode}}</code></p>
      <p class='date-created'>Ngày tiếp nhận: {{formatDate order.CreatedAt}}</p>
    </div>
  </div>

  <div class='receipt-body'>
    <div class='section-box'>
      <h3>👤 Thông tin Khách hàng</h3>
      <div class='info-grid'>
        <div><span class='label'>Họ và tên:</span>
          <strong>{{order.FullName}}</strong></div>
        <div><span class='label'>Số điện thoại:</span>
          <strong>{{order.Phone}}</strong></div>
        {{#if order.Email}}<div><span class='label'>Email:</span>
            {{order.Email}}</div>{{/if}}
      </div>
    </div>

    <div class='section-box'>
      <h3>🖥️ Thông tin Thiết bị Tiếp nhận</h3>
      <div class='info-grid'>
        <div><span class='label'>Loại thiết bị:</span>
          {{order.DeviceType}}</div>
        <div><span class='label'>Hãng sản xuất:</span> {{order.Brand}}</div>
        <div><span class='label'>Model máy:</span> {{order.Model}}</div>
        {{#if order.DeviceSerial}}<div><span class='label'>Serial/IMEI:</span>
            <code>{{order.DeviceSerial}}</code></div>{{/if}}
      </div>
    </div>

    <div class='section-box'>
      <h3>📝 Tình trạng & Mô tả lỗi ban đầu</h3>
      <p class='issue-text'>{{order.IssueDescription}}</p>
    </div>

    <div class='receipt-qr-section'>
      <div class='qr-box'>
        <img
          src='{{qrCodeDataUrl}}'
          alt='QR Code Tra Cứu {{order.TrackingCode}}'
        />
        <p>Quét mã QR bằng Camera điện thoại<br />để tra cứu tiến độ & duyệt báo
          giá</p>
      </div>
      <div class='signature-section'>
        <div class='sig-box'>
          <p><strong>Khách hàng xác nhận</strong></p>
          <small>(Ký và ghi rõ họ tên)</small>
          <div class='sig-space'></div>
        </div>
        <div class='sig-box'>
          <p><strong>Nhân viên tiếp nhận</strong></p>
          <small>({{order.TechnicianName}})</small>
          <div class='sig-space'></div>
        </div>
      </div>
    </div>
  </div>

  <div class='receipt-footer no-print'>
    <button class='btn btn-primary' onclick='window.print()'>🖨️ In Phiếu Tiếp
      Nhận</button>
    <a href='/service-orders/{{order.OrderId}}' class='btn btn-outline'>← Quay
      lại Chi tiết Đơn</a>
  </div>
</div>

<style>
  .receipt-ticket {
    background: #ffffff;
    color: #1e293b;
    max-width: 800px;
    margin: 20px auto;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    font-family: 'Inter', sans-serif;
  }
  .receipt-header {
    border-bottom: 2px solid #3b82f6;
    padding-bottom: 16px;
    margin-bottom: 20px;
    text-align: center;
  }
  .store-info h2 {
    color: #1e40af;
    font-size: 24px;
    margin-bottom: 4px;
  }
  .store-info p {
    margin: 2px 0;
    color: #475569;
    font-size: 13px;
  }
  .ticket-title h1 {
    font-size: 20px;
    font-weight: 700;
    margin: 16px 0 6px;
    color: #0f172a;
    letter-spacing: 0.5px;
  }
  .tracking-big {
    font-size: 18px;
    color: #2563eb;
  }
  .tracking-big code {
    background: #eff6ff;
    padding: 4px 10px;
    border-radius: 6px;
    font-weight: bold;
    border: 1px solid #bfdbfe;
  }
  .date-created {
    font-size: 13px;
    color: #64748b;
    margin-top: 4px;
  }

  .section-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 14px;
  }
  .section-box h3 {
    font-size: 14px;
    color: #334155;
    margin-bottom: 8px;
    font-weight: 600;
  }
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    font-size: 14px;
  }
  .info-grid .label {
    color: #64748b;
  }
  .issue-text {
    font-size: 14px;
    color: #0f172a;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .receipt-qr-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px dashed #cbd5e1;
  }
  .qr-box {
    text-align: center;
  }
  .qr-box img {
    width: 140px;
    height: 140px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
  }
  .qr-box p {
    font-size: 11px;
    color: #64748b;
    margin-top: 6px;
    line-height: 1.3;
  }

  .signature-section {
    display: flex;
    gap: 40px;
    text-align: center;
  }
  .sig-box p {
    font-size: 13px;
    margin-bottom: 2px;
  }
  .sig-box small {
    font-size: 11px;
    color: #64748b;
  }
  .sig-space {
    height: 70px;
  }

  .receipt-footer {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 30px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
  }

  @media print {
    body {
      background: #ffffff !important;
    }
    .no-print {
      display: none !important;
    }
    .receipt-ticket {
      box-shadow: none !important;
      margin: 0 !important;
      max-width: 100% !important;
      padding: 0 !important;
    }
  }
</style>